{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkrovia",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["15,45 * * * *"] },
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "729642103",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkrovia-db",
      "database_id": "82fc716f-f03a-43d8-a60d-02d50129169a",
      "migrations_dir": "migrations",
    },
  ],
  "analytics_engine_datasets": [
    { "binding": "CLICKS", "dataset": "linkrovia_clicks_auto" },
  ],
  "analytics": { "binding": "ANALYTICS_SQL" },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}

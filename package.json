{
  "name": "linkrovia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.3 <13"
  },
  "packageManager": "npm@12.2.3",
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Stores your links, settings, and owner account. Create a new D1 database for this installation."
      },
      "SETUP_TOKEN": {
        "description": "Required. Generate and save a private random password of 32 to 512 characters. Enter the same value on the Linkrovia setup screen after deployment."
      },
      "TURNSTILE_SECRET_KEY": {
        "description": "Optional. Leave blank unless you have created a Turnstile widget for this instance."
      }
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "node scripts/deploy.mjs",
    "preview": "vite preview",
    "types": "wrangler types --config wrangler.jsonc --include-main-module false --env-file .dev.vars.example",
    "check": "npm run types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "svelte-kit sync && vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:seed:local": "node scripts/seed-local.mjs",
    "brand:render": "node scripts/render-brand-card.mjs",
    "timezone:generate": "node scripts/generate-timezones.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@lucide/svelte": "1.77.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "bowser": "2.15.0",
    "chart.js": "4.6.1",
    "drizzle-orm": "0.45.4",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-cloudflare": "9.0.0",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.57.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "^4.1.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "4.166.0"
  }
}
